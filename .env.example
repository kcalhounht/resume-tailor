# OpenRouter API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Used to sign login cookies. Change this in production.
AUTH_SECRET=dev-resume-tailor-secret-change-me

# Neon Postgres. Required on Vercel (the serverless filesystem cannot store data/*.json).
# https://console.neon.tech → your project → Connection string
# Also accepted: POSTGRES_URL, STORAGE_URL (Vercel marketplace custom prefix).
DATABASE_URL=

# Optional overrides
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_NAME=Resume Tailor
